# Python
__pycache__/
*.py[cod]

# Отчёт самопроверки содержит реальные пути машины — не публикуется
selftest-report.txt

# Отчёты проверок документов — тоже результат работы на этой машине
tools/проверки/отчёт-*.txt

# Секреты и кэши этой машины. Публиковать нельзя никогда.
#   config/.secrets/ — блоб DPAPI с hwid и паролем прокси
#   config/cache/    — рабочая конфигурация прокси, ключи password, pass
#                      и auth открытым текстом, плюс логи туннеля
#   device_id, hwid  — идентификаторы этой машины
#   *_migrated       — пустые маркеры переноса настроек
#
# Ничего из этого не было в истории: проверено 04.10, под git не
# отслеживалось. Правила добавлены потому, что ни одно из этих правил
# раньше не закрывало файлы, а `git add .` опубликовал бы их.
config/.secrets/
config/cache/
config/device_id
config/hwid
config/.*_migrated

# Живое состояние программы обхода. Здесь настоящие секреты, поэтому
# правила добавлены сразу после обнаружения, а не «когда понадобится».
#   config/data/incy.db        — база SQLite, 12 625 строк серверов, а
#     в полях есть uuid, password, publicKey, wgPresharedKey,
#     hy2ObfsPassword; плюс 9 подписок с url и hwid. Это учётные данные
#     и адреса подписок в открытом виде. Удалять нельзя: это работающая
#     база человека, в ней его серверы и подписки.
#   config/preferences.json    — 97 полей настроек, включая socks5Username
#     и идентификаторы выбранного сервера.
config/data/
config/preferences.json

# Ярлыки
*.lnk

# Node
node_modules/

# Служебное
Thumbs.db
Desktop.ini

# Отладочные скрипты, которые снимают после проверки правки
_trash-*/

# Отметка «окно первого запуска уже показывали» — состояние этой машины
.first-run-done

# Модель голоса качается скриптом tools\voice\fetch_model.py — 73 МБ
tools/voice/models/

# Скриншоты, которые мост pc-bridge делает для проверки ввода с клавиатуры
tools/pc-bridge/shots/

# Живой список прокси — обновляется кнопкой в окне, отдельно от эталона
tools/antiblock/public_socks5.local.txt

# Личные данные пользователя — не публикуются
profile.md
facts.md
projects.md
созданные-базы.json
debug.log
themes/
sessions/
projects/
личное/
журнал-решений/
память/
библиотека/записи/личное/
библиотека/журнал/
библиотека/АКТИВНАЯ-ПАМЯТЬ.md
библиотека/КАТАЛОГ.md
библиотека/index.json

# Рабочее состояние обхода - не программа.
#   xray.exe              - 34 МБ, качается сам; в репозиторий или сноса не попадет.
#   public_socks5.local.txt - список узлов проверки под своим машины;
#     на другой машине список другой.
#   nodes.local.json      - рабочее состояние фасада.
#   *.bak-*.txt           - старые списки при обновлении.
# Без этого коммит унес бы штаток или 30 мегабайта мусора
# в историю навсегда.
tools/antiblock/xray.exe
tools/antiblock/public_socks5.local.txt
tools/antiblock/nodes.local.json
tools/antiblock/*.bak-*.txt

# Секреты моста DBHub. Публиковать нельзя: это данные этой машины.
#   mcp-dbhub-<имя>-password.txt — пароль базы из строки подключения.
#     Лежит рядом с настройками opencode, и в конфиг его не пишут —
#     но папка настроек может оказаться внутри базы, поэтому правило
#     закрывает и её: по образцу config/.secrets/ выше.
#   mcp-dbhub.toml — подключения: имена хостов, баз и пути к файлам
#     SQLite. Секрета в нём нет (пароль заменён на ${...}), но это
#     состояние этой машины, а не часть базы.
mcp-dbhub-*-password.txt
mcp-*-password.txt
mcp-dbhub.toml
